# Google Cloud & Vertex AI Runtime Configuration
GOOGLE_CLOUD_PROJECT=aecom-demo-uc1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Strategic Model Routing (Flash for fast diagnostics/KB, Gemini 4 Argon for frontier orchestration, legal holds & security escalations)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-4-argon

# Gemini Enterprise & Discovery Engine Registration
GEMINI_ENTERPRISE_LOCATION=global
GEMINI_ENTERPRISE_APP_ID=ask-gbs-enterprise-app

# Persistent Hybrid Memory & RAG Configuration
GBS_MEMORY_DB_PATH=ask_gbs_agent/data/gbs_memory.db
ENABLE_VERTEX_MEMORY_BANK=false
ENABLE_CONTEXT_CACHING=false

# Observability, Secret Manager & Security Guardrails
ENABLE_SECRET_MANAGER=false
ENABLE_CLOUD_LOGGING=false
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
LOG_LEVEL=INFO
